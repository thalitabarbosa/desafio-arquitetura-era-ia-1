# Chaves aceitas pelo provider-fake. Não são segredos reais: só funcionam contra ele.
FAKE_OPENAI_KEY=sk-fake-openai-0001
FAKE_ANTHROPIC_KEY=sk-ant-fake-0001

# AI Gateway (LiteLLM). A master key só existe no gateway; a aplicação recebe apenas a
# chave virtual dela (HELPDESK_GATEWAY_KEY), criada automaticamente na subida.
LITELLM_MASTER_KEY=sk-gateway-master-0001
HELPDESK_GATEWAY_KEY=sk-helpdesk-app-0001
GATEWAY_DB_PASSWORD=litellm-local-0001
# Chaves virtuais usadas só no roteiro de governança do README (orçamento e limite de requisições).
GOVERNANCE_BUDGET_KEY=sk-demo-budget-0001
GOVERNANCE_RPM_KEY=sk-demo-rpm-0001
